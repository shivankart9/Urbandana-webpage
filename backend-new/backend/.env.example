# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.

# Your MongoDB Atlas connection string.
# IMPORTANT: if the password contains special characters like @ : / ? # [ ] % etc,
# it must be percent-encoded (e.g. "aA@97265827" -> "aA%4097265827").
MONGODB_URI=mongodb+srv://shivankart9:aA%4097265827@cluster0.c7mt906.mongodb.net/urbandana?retryWrites=true&w=majority&appName=Cluster0

# Port the Express server listens on
PORT=5000

# Secret used to sign login (JWT) tokens — make this a long random string
JWT_SECRET=replace_with_a_long_random_string

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Razorpay — get these from Dashboard > Settings > API Keys
# Use your test keys (rzp_test_...) until you're ready to go live (rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_TgUQaQVgnqJLcj
RAZORPAY_KEY_SECRET=OSypmtgqnXdcuXhr2gO3vO4H

# Razorpay > Settings > Webhooks > add a webhook secret (optional but recommended)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
